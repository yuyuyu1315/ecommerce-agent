# ============================================================
# 电商运营 Agent - 环境变量模板
# 复制为 .env 后填写真实值
# ============================================================

# 应用配置
APP_NAME=电商运营Agent
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# 数据库配置（本地默认 SQLite，部署可用 PostgreSQL）
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ecommerce_agent
DATABASE_URL=sqlite+aiosqlite:///D:/ecommerce-agent/data/ecommerce.db

# Redis 配置（本地未装 Redis 时可保持，代码做降级）
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=false
CACHE_TTL=3600

# LLM 配置 - DeepSeek（OpenAI 兼容）
LLM_PROVIDER=deepseek
OPENAI_API_KEY=sk-xxxx-your-deepseek-key
OPENAI_MODEL=deepseek-flash
OPENAI_BASE_URL=https://api.deepseek.com

# LLM 配置 - 智谱 GLM（备选）
# LLM_PROVIDER=zhipu
# ZHIPU_API_KEY=your-zhipu-api-key
# ZHIPU_MODEL=glm-4

# LLM 配置 - 通义千问（备选）
# LLM_PROVIDER=qwen
# QWEN_API_KEY=your-qwen-api-key
# QWEN_MODEL=qwen-turbo

# RAG 配置
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_PATH=D:/ecommerce-agent/data/chromadb
RAG_TOP_K=5

# CORS 配置（Vite 前端默认 5173）
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
